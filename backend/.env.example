# Copy to backend/.env and adjust. Every setting is optional.
ENV=development
LOG_LEVEL=INFO
# LOG_JSON=true                      # JSON logs (default in ENV=production)
STORAGE=auto                         # auto | mongodb | memory
MONGO_URL=mongodb://localhost:27017
MONGO_DB=maxresume
# API_KEYS=alice:change-me,ats-bot:another-key   # enables auth; key names appear in the audit log
CORS_ORIGINS=http://localhost:5173
DEFAULT_PHONE_REGION=US              # region for phone numbers written without a country code
MAX_FILE_MB=10
MAX_BATCH=50
MAX_PDF_PAGES=15
PARSE_TIMEOUT_S=90
PARSE_WORKERS=4
OCR_ENABLED=true
OCR_MAX_PAGES=6
ENABLE_SAMPLES=true
